<style>

/* =====================================================
   RESET
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
    overflow-x:auto;
    overflow-y:hidden;
    scroll-snap-type:x mandatory;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    color:#ffffff;
    background:#050816;
    overflow-x:auto;
    overflow-y:hidden;
}


/* =====================================================
   ANIMATED AI BACKGROUND
===================================================== */

body{
    background:
        radial-gradient(
            circle at 15% 20%,
            rgba(0,210,255,.20),
            transparent 28%
        ),
        radial-gradient(
            circle at 85% 25%,
            rgba(130,70,255,.22),
            transparent 30%
        ),
        radial-gradient(
            circle at 50% 90%,
            rgba(236,72,153,.14),
            transparent 28%
        ),
        linear-gradient(
            135deg,
            #030712,
            #071331,
            #0b1230,
            #050816
        );

    background-size:200% 200%;
    animation:backgroundMove 15s ease infinite;
}

@keyframes backgroundMove{

    0%{
        background-position:0% 50%;
    }

    50%{
        background-position:100% 50%;
    }

    100%{
        background-position:0% 50%;
    }
}


/* TECH DOTS */

body::before{
    content:"";

    position:fixed;

    inset:0;

    background-image:
        radial-gradient(
            rgba(70,200,255,.55) 1px,
            transparent 1px
        );

    background-size:35px 35px;

    opacity:.18;

    pointer-events:none;

    z-index:-2;
}


/* GLOW */

body::after{
    content:"";

    position:fixed;

    width:500px;
    height:500px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            rgba(0,200,255,.14),
            transparent 70%
        );

    left:15%;
    top:20%;

    filter:blur(40px);

    animation:floatingGlow 9s ease-in-out infinite;

    pointer-events:none;

    z-index:-1;
}

@keyframes floatingGlow{

    0%{
        transform:translate(0,0);
    }

    50%{
        transform:translate(300px,150px);
    }

    100%{
        transform:translate(0,0);
    }
}


/* =====================================================
   NAVBAR
===================================================== */

.navbar{

    position:fixed;

    top:0;
    left:0;

    width:100%;

    height:75px;

    padding:0 7vw;

    display:flex;

    align-items:center;

    justify-content:space-between;

    background:rgba(5,10,30,.72);

    backdrop-filter:blur(16px);

    border-bottom:
        1px solid
        rgba(100,200,255,.15);

    z-index:1000;
}

.logo{

    font-size:26px;

    font-weight:800;

    color:white;

    letter-spacing:1px;
}

.logo span{

    color:#40d9ff;
}


.nav-links{

    display:flex;

    gap:28px;
}

.nav-links a{

    color:#d9edff;

    text-decoration:none;

    font-size:13px;

    font-weight:600;

    position:relative;

    transition:.3s;
}

.nav-links a:hover{

    color:#45dfff;

}

.nav-links a::after{

    content:"";

    position:absolute;

    left:0;

    bottom:-8px;

    width:0;

    height:2px;

    background:#45dfff;

    box-shadow:
        0 0 10px #45dfff;

    transition:.3s;
}

.nav-links a:hover::after{

    width:100%;

}


/* =====================================================
   MAIN HORIZONTAL TRACK
===================================================== */

#portfolio{

    display:flex;

    flex-direction:row;

    width:max-content;

    min-width:100vw;
}


/* =====================================================
   EACH PAGE
===================================================== */

.page{

    width:100vw;

    min-width:100vw;

    height:100vh;

    min-height:100vh;

    flex:0 0 100vw;

    scroll-snap-align:start;

    scroll-snap-stop:always;

    overflow-y:auto;

    overflow-x:hidden;

    padding:
        110px
        7vw
        60px;

    position:relative;
}


/* =====================================================
   GLASS EFFECT
===================================================== */

.glass{

    background:
        rgba(255,255,255,.055);

    border:
        1px solid
        rgba(120,220,255,.16);

    backdrop-filter:blur(15px);

    box-shadow:
        0 20px 60px
        rgba(0,0,0,.25),

        inset 0 1px 0
        rgba(255,255,255,.07);
}


/* =====================================================
   HOME
===================================================== */

.home{

    display:grid;

    grid-template-columns:
        1fr 1fr;

    align-items:center;

    gap:80px;
}

.home-content{

    max-width:700px;

    animation:
        fadeUp 1s ease;
}

@keyframes fadeUp{

    from{
        opacity:0;
        transform:translateY(30px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}


.eyebrow{

    font-size:11px;

    letter-spacing:3px;

    color:#61dcff;

    font-weight:bold;

    margin-bottom:22px;
}


.home h1{

    font-family:
        Georgia,
        serif;

    font-size:
        clamp(55px,8vw,105px);

    line-height:.92;

    letter-spacing:-3px;

    margin-bottom:30px;
}

.home h1 span{

    color:#43dfff;

    text-shadow:
        0 0 25px
        rgba(67,223,255,.45);
}

.home h1 em{

    font-style:italic;

    color:#cbb8ff;

    text-shadow:
        0 0 25px
        rgba(160,120,255,.4);
}


.home-description{

    color:#b9c9d8;

    font-size:17px;

    line-height:1.8;

    max-width:600px;
}


/* BUTTONS */

.buttons{

    display:flex;

    gap:15px;

    margin-top:32px;

    flex-wrap:wrap;
}

.btn{

    padding:
        14px
        24px;

    border-radius:40px;

    text-decoration:none;

    font-weight:bold;

    font-size:14px;

    transition:.3s;

}

.btn:hover{

    transform:
        translateY(-5px);

}


.btn-primary{

    color:#02101c;

    background:
        linear-gradient(
            90deg,
            #42dcff,
            #8b7bff
        );

    box-shadow:
        0 0 25px
        rgba(66,220,255,.25);
}


.btn-secondary{

    color:white;

    border:
        1px solid
        rgba(120,220,255,.35);

    background:
        rgba(255,255,255,.05);
}


/* =====================================================
   PROFILE
===================================================== */

.profile-area{

    display:flex;

    justify-content:center;

    align-items:center;

    position:relative;
}

.profile{

    width:360px;

    height:450px;

    border-radius:
        190px
        190px
        25px
        25px;

    padding:7px;

    background:
        linear-gradient(
            135deg,
            #35dfff,
            #785cff,
            #ec4899
        );

    box-shadow:
        0 0 50px
        rgba(40,210,255,.20);

    animation:
        profileFloat 5s ease-in-out infinite;
}

@keyframes profileFloat{

    0%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-12px);
    }

    100%{
        transform:translateY(0);
    }
}

.profile img{

    width:100%;

    height:100%;

    object-fit:cover;

    object-position:center top;

    border-radius:
        185px
        185px
        20px
        20px;

    display:block;
}


.profile-card{

    position:absolute;

    right:-10px;

    bottom:35px;

    padding:
        17px
        22px;

    border-radius:14px;

    background:
        rgba(10,20,45,.8);

    border:
        1px solid
        rgba(100,220,255,.2);

    backdrop-filter:blur(15px);

    box-shadow:
        0 15px 40px
        rgba(0,0,0,.35);
}

.profile-card strong{

    display:block;

    color:#61ddff;

    font-size:14px;
}

.profile-card small{

    color:#aab8c7;

    margin-top:5px;

    display:block;
}


/* =====================================================
   SECTION LAYOUT
===================================================== */

.section{

    width:100%;

    height:100%;

    display:grid;

    grid-template-columns:
        220px 1fr;

    gap:70px;

    align-items:center;
}


.section-number{

    font-size:11px;

    letter-spacing:3px;

    color:#50dcff;

    font-weight:bold;
}


.section-content{

    max-width:1000px;
}


.section h2{

    font-family:
        Georgia,
        serif;

    font-size:
        clamp(45px,6vw,75px);

    line-height:1;

    margin-bottom:35px;

    color:white;
}


.section h2 em{

    font-style:italic;

    color:#c7b8ff;
}


.section-content > p{

    color:#aebdca;

    font-size:17px;

    line-height:1.9;

    margin-bottom:20px;

    max-width:850px;
}


/* =====================================================
   SKILLS
===================================================== */

.skills{

    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:15px;
}


.skill{

    padding:25px;

    border-radius:16px;

    background:
        rgba(255,255,255,.045);

    border:
        1px solid
        rgba(120,220,255,.14);

    backdrop-filter:blur(12px);

    transition:.35s;

    min-height:160px;
}


.skill:hover{

    transform:
        translateY(-9px)
        scale(1.02);

    border-color:
        rgba(70,220,255,.55);

    box-shadow:
        0 15px 40px
        rgba(30,180,255,.12);
}


.skill-number{

    color:#52dcff;

    font-size:11px;
}


.skill h3{

    color:white;

    margin:
        28px
        0
        10px;

    font-size:18px;
}


.skill p{

    color:#98aaba;

    font-size:13px;

    line-height:1.5;
}


/* =====================================================
   PROJECTS
===================================================== */

.projects{

    width:100%;

    max-width:1000px;
}


.project{

    display:grid;

    grid-template-columns:
        60px 1fr 40px;

    gap:20px;

    padding:
        28px
        0;

    border-bottom:
        1px solid
        rgba(120,220,255,.13);

    transition:.3s;
}


.project:hover{

    padding-left:15px;

}


.project-number{

    color:#52dcff;

    font-weight:bold;
}


.project h3{

    color:white;

    font-size:25px;

    margin-bottom:10px;
}


.project p{

    color:#a9b9c7;

    line-height:1.7;

    max-width:800px;
}


.project-arrow{

    color:#53ddff;

    font-size:25px;
}


.tags{

    display:flex;

    gap:8px;

    margin-top:15px;

    flex-wrap:wrap;
}


.tag{

    border:
        1px solid
        rgba(100,220,255,.25);

    color:#86dcf5;

    padding:
        6px
        12px;

    border-radius:30px;

    font-size:10px;
}


/* =====================================================
   EDUCATION
===================================================== */

.education{

    width:100%;

    max-width:1000px;
}


.education-item{

    display:grid;

    grid-template-columns:
        140px 1fr;

    gap:30px;

    padding:28px 0;

    border-bottom:
        1px solid
        rgba(120,220,255,.13);
}


.education-item small{

    color:#52dcff;

    letter-spacing:2px;

    font-weight:bold;
}


.education-item h3{

    color:white;

    font-size:22px;

    margin-bottom:8px;
}


.education-item p{

    color:#aab9c7;

    margin:0;

    line-height:1.7;
}


/* =====================================================
   CONTACT
===================================================== */

.contact{

    background:
        radial-gradient(
            circle at 50% 30%,
            rgba(70,210,255,.12),
            transparent 40%
        );

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;

    text-align:center;
