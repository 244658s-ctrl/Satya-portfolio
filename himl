.contact h2 em{

    color:#cbb9ff;

    font-style:italic;
}


.contact-boxes{

    display:flex;

    gap:20px;

    justify-content:center;

    flex-wrap:wrap;
}


.contact-box{

    min-width:300px;

    padding:
        22px
        30px;

    border-radius:15px;

    background:
        rgba(255,255,255,.05);

    border:
        1px solid
        rgba(100,220,255,.2);

    backdrop-filter:blur(15px);

    text-align:left;

    transition:.3s;
}


.contact-box:hover{

    transform:
        translateY(-7px);

    border-color:
        rgba(70,220,255,.6);

    box-shadow:
        0 15px 40px
        rgba(30,190,255,.12);
}


.contact-box small{

    display:block;

    color:#61ddff;

    letter-spacing:2px;

    font-size:10px;

    margin-bottom:8px;
}


.contact-box a{

    color:white;

    text-decoration:none;

    font-weight:bold;

    word-break:break-word;
}


/* =====================================================
   PAGE INDICATOR
===================================================== */

.page-indicator{

    position:fixed;

    bottom:22px;

    left:50%;

    transform:translateX(-50%);

    display:flex;

    gap:8px;

    z-index:500;
}


.dot{

    width:8px;

    height:8px;

    border-radius:50%;

    background:#64748b;

    transition:.3s;
}


.dot.active{

    width:28px;

    border-radius:20px;

    background:
        linear-gradient(
            90deg,
            #42ddff,
            #8b72ff
        );

    box-shadow:
        0 0 12px
        rgba(60,220,255,.6);
}


/* =====================================================
   SCROLL INDICATOR
===================================================== */

.scroll-indicator{

    position:fixed;

    right:30px;

    bottom:22px;

    color:#6edfff;

    font-size:11px;

    letter-spacing:2px;

    z-index:500;

    animation:
        scrollMove 1.5s infinite;
}

@keyframes scrollMove{

    0%,100%{
        transform:translateX(0);
    }

    50%{
        transform:translateX(8px);
    }
}


/* =====================================================
   SCROLLBAR
===================================================== */

::-webkit-scrollbar{

    height:7px;

    width:7px;
}

::-webkit-scrollbar-track{

    background:#071027;
}

::-webkit-scrollbar-thumb{

    background:
        linear-gradient(
            90deg,
            #42dcff,
            #8b72ff
        );

    border-radius:20px;
}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:850px){

    .nav-links{

        display:none;
    }

    .page{

        padding:
            100px
            6vw
            60px;
    }

    .home{

        grid-template-columns:1fr;

        gap:40px;
    }

    .profile{

        width:270px;

        height:340px;
    }

    .section{

        grid-template-columns:1fr;

        gap:25px;

        align-items:start;

        padding-top:110px;
    }

    .skills{

        grid-template-columns:
            repeat(2,1fr);
    }

    .project{

        grid-template-columns:
            40px 1fr 25px;
    }

    .education-item{

        grid-template-columns:1fr;

        gap:10px;
    }

    .scroll-indicator{

        display:none;
    }

}


@media(max-width:500px){

    .skills{

        grid-template-columns:1fr;
    }

    .profile{

        width:230px;

        height:290px;
    }

    .home h1{

        font-size:55px;
    }

}

</style>
</head>


